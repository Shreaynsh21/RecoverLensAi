# Local synthetic demo accounts for scripts/seed_demo.py
DEMO_CLINICIAN_EMAIL=clinician.demo@example.test
DEMO_CLINICIAN_PASSWORD=replace_with_a_unique_demo_password
DEMO_PATIENT_EMAIL=patient.demo@example.test
DEMO_PATIENT_PASSWORD=replace_with_another_unique_demo_password
