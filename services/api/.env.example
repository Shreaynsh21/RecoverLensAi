APP_NAME=RecoverLens API
APP_ENV=development
DEBUG=true

MYSQL_USER=recoverlens_app
MYSQL_PASSWORD=change_me
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=recoverlens

CORS_ORIGINS=http://localhost:5173
# Authentication: replace the placeholder with a random secret locally
JWT_SECRET_KEY=replace_with_a_random_secret_of_at_least_32_characters
